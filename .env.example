# Who serves the chat model: ollama | openai | anthropic
# PROVIDER=ollama
# Credential for a hosted provider. Required unless PROVIDER=ollama
# API_KEY=

# Model tag, in whatever form the provider names its models
MODEL=qwen3:4b

# Embeddings for long-term memory. Pulled separately: `ollama pull bge-m3`
EMBEDDING_MODEL=bge-m3:latest
# Vector width of EMBEDDING_MODEL; change only together with the model
# EMBEDDING_DIMS=1024

# Workspace the filesystem/shell tools are confined to
# WORKSPACE_ROOT=/path/to/workspace
# Opt-in capabilities
FILESYSTEM_WRITABLE=false
ENABLE_SHELL=false
ENABLE_FILE_SEARCH=false

# --- Langfuse (docker compose up -d, UI at http://localhost:3000) ---
# Project API keys for the SDK. Langfuse registers exactly these on first start,
# so any pk-lf-/sk-lf- strings work; changing them later needs a fresh volume
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=sk-lf-local
LANGFUSE_BASE_URL=http://localhost:3000
# Tracing is on exactly when both keys above are set; remove them to turn it off.
# Separates dev from prod traces in one project: lowercase, digits, - and _
# LANGFUSE_TRACING_ENVIRONMENT=development
# Code version behind a trace, e.g. LANGFUSE_RELEASE=$(git rev-parse --short HEAD)
# LANGFUSE_RELEASE=
# Share of turns traced, 0.0-1.0
# LANGFUSE_SAMPLE_RATE=1.0

# UI login, created on first start
LF_USER_EMAIL=admin@local.dev
LF_USER_PASSWORD=CHANGEME

# Server-side secrets, read only by docker-compose.yml.
# Hex only: they are pasted into URLs. Generate each with `openssl rand -hex 32`
LF_NEXTAUTH_SECRET=CHANGEME
LF_SALT=CHANGEME
LF_ENCRYPTION_KEY=CHANGEME
LF_POSTGRES_PASSWORD=CHANGEME
LF_CLICKHOUSE_PASSWORD=CHANGEME
LF_REDIS_PASSWORD=CHANGEME
LF_MINIO_PASSWORD=CHANGEME
